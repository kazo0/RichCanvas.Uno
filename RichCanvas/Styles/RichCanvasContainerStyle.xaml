<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:RichCanvas">
    <!-- [WPF Migration] TargetType="{x:Type local:RichCanvasContainer}" changed to TargetType="local:RichCanvasContainer" -->
    <Style TargetType="local:RichCanvasContainer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RichCanvasContainer">
                    <ContentPresenter x:Name="PART_ContentPresenter" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
