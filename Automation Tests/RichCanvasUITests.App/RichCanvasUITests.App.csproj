<Project Sdk="Uno.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-desktop</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>
		<RootNamespace>RichCanvasUITests.App</RootNamespace>
		<Nullable>enable</Nullable>
		<LangVersion>default</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>

		<ApplicationTitle>RichCanvasUITests</ApplicationTitle>

		<UnoFeatures>
			SkiaRenderer;
		</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\RichCanvas\RichCanvas.csproj" />
	</ItemGroup>

</Project>
