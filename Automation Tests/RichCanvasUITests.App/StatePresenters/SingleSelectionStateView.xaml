<UserControl x:Class="RichCanvasUITests.App.StatePresenters.SingleSelectionStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <x:Int64 x:Key="1">0</x:Int64>
        <x:Int64 x:Key="2">1</x:Int64>
        <x:Int64 x:Key="3">2</x:Int64>
    </UserControl.Resources>

    <Expander IsExpanded="True">
        <Expander.Header>
            <TextBlock Text="Single Selection State Tests" />
        </Expander.Header>
        <Expander.Content>
            <StackPanel>
                <Button Command="{Binding AddSingleSelectionItemsForTest}"
                        AutomationProperties.AutomationId="AddTestSingleSelectionItems"
                        Content="Add Single Selection Test Items" />

                <Button Command="{Binding SetSelectedItemCommand}"
                        CommandParameter="{StaticResource 1}"
                        AutomationProperties.AutomationId="SetSingleSelectedItem1"
                        Content="Set Selected Item 1" />

                <Button Command="{Binding SetSelectedItemCommand}"
                        CommandParameter="{StaticResource 2}"
                        AutomationProperties.AutomationId="SetSingleSelectedItem2"
                        Content="Set Selected Item 2" />

                <Button Command="{Binding SetSelectedItemCommand}"
                        CommandParameter="{StaticResource 3}"
                        AutomationProperties.AutomationId="SetSingleSelectedItem3"
                        Content="Set Selected Item 3" />
            </StackPanel>
        </Expander.Content>
    </Expander>
</UserControl>
