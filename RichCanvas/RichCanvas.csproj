<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<TargetFrameworks>net9.0</TargetFrameworks>
		<LangVersion>default</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Authors>Mircea Staicu</Authors>
		<RepositoryUrl>https://github.com/mircea21S/RichCanvas</RepositoryUrl>
		<PackageProjectUrl>https://github.com/mircea21S/RichCanvas</PackageProjectUrl>
		<Company />
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Mircea Staicu</Copyright>
		<PackageTags>
			uno-platform winui canvas zooming items panning selection drawable draggable
			infinite-canvas infinite-scrolling
		</PackageTags>
		<Description>
			Enhanced Canvas control for Uno Platform (WinUI) with panning, zooming, scrolling and other customizable functions, designed for MVVM.
		</Description>
		<Version>4.0.0</Version>
		<PackageReleaseNotes>
			<![CDATA[
		------------ RichCanvas v4.0.0 ------------
			- Breaking Changes:
				- Migrated from WPF to Uno Platform (WinUI 3 API surface)
				- Base class changed from MultiSelector to ItemsControl
				- IScrollInfo removed; custom scroll management via ScrollViewer
				- RoutedCommands replaced with ICommand / XamlUICommand
				- InputGesture system replaced with custom pointer-based gesture matching
				- Mouse/Keyboard static APIs replaced with pointer event APIs
				- Routed events replaced with standard CLR events
				- Newtonsoft.Json replaced with System.Text.Json
				- GeometryHitTest replaced with bounds-intersection testing
			]]>
		</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\icon.png" Condition="Exists('..\icon.png')">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\README.md" Condition="Exists('..\README.md')">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Uno.WinUI" Version="6.0.465" />
	</ItemGroup>

</Project>
