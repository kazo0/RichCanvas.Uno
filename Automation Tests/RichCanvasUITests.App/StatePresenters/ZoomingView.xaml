<UserControl x:Class="RichCanvasUITests.App.StatePresenters.ZoomingStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="using:RichCanvasUITests.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverterKey" />
    </UserControl.Resources>

    <Grid>
        <Expander IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="Zooming State Tests" />
            </Expander.Header>
            <Expander.Content>
                <StackPanel>
                    <TextBox Text="{Binding MaxScale, Mode=TwoWay, Converter={StaticResource StringToDoubleConverterKey}}"
                             AutomationProperties.AutomationId="MaxScaleTextBox" />
                    <TextBox Text="{Binding MinScale, Mode=TwoWay, Converter={StaticResource StringToDoubleConverterKey}}"
                             AutomationProperties.AutomationId="MinScaleTextBox" />
                    <TextBox Text="{Binding ScaleFactor, Mode=TwoWay, Converter={StaticResource StringToDoubleConverterKey}}"
                             AutomationProperties.AutomationId="ScaleFactorTextBox" />
                    <TextBox Text="{Binding ViewportZoom, Mode=TwoWay, Converter={StaticResource StringToDoubleConverterKey}}"
                             AutomationProperties.AutomationId="ViewportZoomTextBox" />
                </StackPanel>
            </Expander.Content>
        </Expander>
    </Grid>
</UserControl>
