<Window x:Class="RichCanvasUITests.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:RichCanvasUITests.App"
        xmlns:auto="using:RichCanvasUITests.App.Automation"
        xmlns:rc="using:RichCanvas"
        xmlns:statePresenters="using:RichCanvasUITests.App.StatePresenters"
        mc:Ignorable="d"
        Title="MainWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Width="150">
            <StackPanel>

                <statePresenters:DrawingStateView DataContext="{Binding DrawingState}" />
                <Border Height="2" Background="Gray" Margin="5" HorizontalAlignment="Stretch" />

                <statePresenters:MultipleSelectionStateView DataContext="{Binding MultipleSelectionState}" />
                <Border Height="2" Background="Gray" Margin="5" HorizontalAlignment="Stretch" />

                <statePresenters:SingleSelectionStateView DataContext="{Binding SingleSelectionState}" />
                <Border Height="2" Background="Gray" Margin="5" HorizontalAlignment="Stretch" />

                <statePresenters:ZoomingStateView DataContext="{Binding ZoomingViewModel}" />
                <Border Height="2" Background="Gray" Margin="5" HorizontalAlignment="Stretch" />

                <Button Command="{Binding UpdateItemsSourceCommand}"
                        AutomationProperties.AutomationId="MoveFirstItemToTheEnd"
                        Content="Move First Item" />

                <Button Command="{Binding RemoveFirstItemCommand}"
                        AutomationProperties.AutomationId="RemoveFirstItem"
                        Content="Remove First Item" />

                <Button Command="{Binding SwitchItemsPositionCommand}"
                        Content="Switch Items" />

                <Button Command="{Binding ClearAllItemsCommand}"
                        AutomationProperties.AutomationId="ClearItems"
                        Content="Clear all items" />

                <Border BorderThickness="1"
                        BorderBrush="BlueViolet"
                        Margin="2">
                    <StackPanel>
                        <ToggleButton AutomationProperties.AutomationId="RealTimeSelectionToggle"
                                      IsChecked="{Binding RealTimeSelectionEnabled, Mode=TwoWay}"
                                      Content="RealTimeSelection" />

                        <ToggleButton AutomationProperties.AutomationId="CanSelectMultipleItemsToggle"
                                      IsChecked="{Binding CanSelectMultipleItems, Mode=TwoWay}"
                                      Content="CanSelectMultipleItems" />

                        <ToggleButton AutomationProperties.AutomationId="RealTimeDraggingToggleButton"
                                      IsChecked="{Binding RealTimeDraggingEnabled, Mode=TwoWay}"
                                      Content="RealTimeDragging" />
                    </StackPanel>
                </Border>

                <Border BorderThickness="1"
                        BorderBrush="Black"
                        Margin="2">
                    <StackPanel>
                        <TextBlock x:Name="SelectedItemHeightText" />
                        <TextBlock x:Name="SelectedItemWidthText" />
                        <TextBlock x:Name="SelectedItemTopText" />
                        <TextBlock x:Name="SelectedItemLeftText" />
                        <TextBox AutomationProperties.AutomationId="RichItemContainerAngleTextBox"
                                 Text="{Binding SelectedItem.Angle, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="MousePositionText" />
                <TextBlock x:Name="ItemsCountText" />
                <TextBlock x:Name="SelectedItemsCountText" />
                <TextBlock AutomationProperties.AutomationId="ViewportLocationTextBlock"
                           x:Name="ViewportLocationText" />
                <TextBlock x:Name="ViewportSizeText" />

                <Border BorderThickness="1"
                        BorderBrush="Black"
                        Margin="2">
                    <StackPanel>
                        <TextBox Text="{Binding GridSpacing, Mode=TwoWay}" />
                        <CheckBox IsChecked="{Binding EnableSnapping, Mode=TwoWay}"
                                  Content="Enable Snapping" />
                        <Button AutomationProperties.AutomationId="ResetViewportLocationButton"
                                Content="Reset Viewport Location"
                                Command="{Binding ResetViewportLocation}" />
                        <Button AutomationProperties.AutomationId="SetViewportLocationValueButton"
                                Content="Set Viewport Location Value"
                                Command="{Binding SetViewportLocationValue}" />
                        <Button AutomationProperties.AutomationId="ResetViewportZoomButton"
                                Content="Reset Viewport Zoom"
                                Command="{Binding ResetViewportZoomCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <rc:RichCanvas x:Name="source"
                           ItemsSource="{Binding Items}"
                           SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                           SelectedItems="{Binding SelectedItems}"
                           RealTimeSelectionEnabled="{Binding RealTimeSelectionEnabled}"
                           CanSelectMultipleItems="{Binding CanSelectMultipleItems}"
                           RealTimeDraggingEnabled="{Binding RealTimeDraggingEnabled}"
                           DrawingEndedCommand="{Binding DrawingState.DrawingEndedCommand}"
                           ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                           ViewportZoom="{Binding ZoomingViewModel.ViewportZoom, Mode=TwoWay}"
                           ScrollFactor="100"
                           MinScale="{Binding ZoomingViewModel.MinScale, Mode=TwoWay}"
                           MaxScale="{Binding ZoomingViewModel.MaxScale, Mode=TwoWay}"
                           ScaleFactor="{Binding ZoomingViewModel.ScaleFactor, Mode=TwoWay}"
                           EnableSnapping="{Binding EnableSnapping, Mode=TwoWay}"
                           GridSpacing="{Binding GridSpacing, Mode=TwoWay}">
                <rc:RichCanvas.ItemContainerStyle>
                    <Style TargetType="rc:RichCanvasContainer">
                        <Setter Property="Top"
                                Value="{Binding Top, Mode=TwoWay}" />
                        <Setter Property="Left"
                                Value="{Binding Left, Mode=TwoWay}" />
                        <Setter Property="Width"
                                Value="{Binding Width, Mode=TwoWay}" />
                        <Setter Property="Height"
                                Value="{Binding Height, Mode=TwoWay}" />
                        <Setter Property="AllowScaleChangeToUpdatePosition"
                                Value="{Binding AllowScaleChangeToUpdatePosition}" />
                    </Style>
                </rc:RichCanvas.ItemContainerStyle>
            </rc:RichCanvas>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                Padding="8,4">
            <TextBlock x:Name="ZoomText" />
        </Border>
    </Grid>
</Window>
