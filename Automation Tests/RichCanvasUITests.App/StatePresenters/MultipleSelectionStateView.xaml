<UserControl x:Class="RichCanvasUITests.App.StatePresenters.MultipleSelectionStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <x:Int64 x:Key="1">1</x:Int64>
        <x:Int64 x:Key="2">2</x:Int64>

        <x:Int64 x:Key="Select1Item">1</x:Int64>
        <x:Int64 x:Key="Select2Items">2</x:Int64>
        <x:Int64 x:Key="Select3Items">3</x:Int64>
        <x:Int64 x:Key="Select5Items">5</x:Int64>
    </UserControl.Resources>

    <Expander IsExpanded="True">
        <Expander.Header>
            <TextBlock Text="Multiple Selection State Tests" />
        </Expander.Header>
        <Expander.Content>
            <StackPanel>
                <Button Command="{Binding AddSelectableItemsCommmand}"
                        CommandParameter="{StaticResource 1}"
                        AutomationProperties.AutomationId="AddSelectableItems1"
                        Content="Add Selectable Items 1" />
                <Button Command="{Binding AddSelectableItemsCommmand}"
                        CommandParameter="{StaticResource 2}"
                        AutomationProperties.AutomationId="AddSelectableItems2"
                        Content="Add Selectable Items 2" />

                <Button Command="{Binding AddSelectedItemsCommand}"
                        CommandParameter="{StaticResource Select1Item}"
                        AutomationProperties.AutomationId="SelectFirst1ItemsNotSelected"
                        Content="Add 1 Selected Item" />
                <Button Command="{Binding AddSelectedItemsCommand}"
                        CommandParameter="{StaticResource Select2Items}"
                        AutomationProperties.AutomationId="SelectFirst2ItemsNotSelected"
                        Content="Add 2 Selected Item" />
                <Button Command="{Binding AddSelectedItemsCommand}"
                        CommandParameter="{StaticResource Select3Items}"
                        AutomationProperties.AutomationId="SelectFirst3ItemsNotSelected"
                        Content="Add 3 Selected Item" />
                <Button Command="{Binding AddSelectedItemsCommand}"
                        CommandParameter="{StaticResource Select5Items}"
                        AutomationProperties.AutomationId="SelectFirst5ItemsNotSelected"
                        Content="Add 5 Selected Item" />
                <Button Command="{Binding SelectAllItemsCommand}"
                        AutomationProperties.AutomationId="SelectAllItems"
                        Content="Select All Items" />
            </StackPanel>
        </Expander.Content>
    </Expander>
</UserControl>
